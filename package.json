{
  "name": "algiviz",
  "version": "0.1.0",
  "description": "Deterministic algorithm steps for educational visualizations",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js",
      "default": "./dist/canvas/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "author": {
    "name": "Grundy",
    "url": "https://grundyjs.ru/"
  },
  "homepage": "https://grundyjs.ru/algorithms/insertion-sort/",
  "keywords": [
    "algorithms",
    "visualization",
    "insertion-sort",
    "canvas",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urffin/algiviz.git"
  },
  "bugs": {
    "url": "https://github.com/urffin/algiviz/issues"
  }
}
