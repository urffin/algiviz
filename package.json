{
  "name": "@grundyjs/algiviz",
  "version": "1.3.0",
  "description": "TypeScript toolkit for custom algorithm visualizations with step-by-step playback and extensible rendering",
  "type": "module",
  "files": [
    "dist/array",
    "dist/graph",
    "dist/tree",
    "dist/grid",
    "dist/playback",
    "dist/scene",
    "dist/canvas",
    "dist/player",
    "dist/worker",
    "README.md",
    "ru/README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "import": "./dist/tree/index.js",
      "default": "./dist/tree/index.js"
    },
    "./canvas/graph": {
      "types": "./dist/canvas/graph.d.ts",
      "import": "./dist/canvas/graph.js",
      "default": "./dist/canvas/graph.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js",
      "default": "./dist/graph/index.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "import": "./dist/scene/index.js",
      "default": "./dist/scene/index.js"
    },
    "./array": {
      "types": "./dist/array/index.d.ts",
      "import": "./dist/array/index.js",
      "default": "./dist/array/index.js"
    },
    "./playback": {
      "types": "./dist/playback/index.d.ts",
      "import": "./dist/playback/index.js",
      "default": "./dist/playback/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js",
      "default": "./dist/player/index.js"
    },
    "./canvas/viewport": {
      "types": "./dist/canvas/viewport.d.ts",
      "import": "./dist/canvas/viewport.js",
      "default": "./dist/canvas/viewport.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js",
      "default": "./dist/canvas/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./worker/runtime": {
      "types": "./dist/worker/runtime.d.ts",
      "import": "./dist/worker/runtime.js",
      "default": "./dist/worker/runtime.js"
    },
    "./canvas/tree": {
      "types": "./dist/canvas/tree.d.ts",
      "import": "./dist/canvas/tree.js",
      "default": "./dist/canvas/tree.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "import": "./dist/grid/index.js",
      "default": "./dist/grid/index.js"
    },
    "./canvas/grid": {
      "types": "./dist/canvas/grid.d.ts",
      "import": "./dist/canvas/grid.js",
      "default": "./dist/canvas/grid.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:bundle": "node scripts/test-bundle.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "author": {
    "name": "Grundy",
    "url": "https://grundyjs.ru/"
  },
  "homepage": "https://grundyjs.ru/algiviz/",
  "keywords": [
    "algorithm-visualization",
    "algorithms",
    "visualization",
    "animation",
    "step-by-step",
    "playback",
    "data-structures",
    "educational",
    "canvas",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urffin/algiviz.git"
  },
  "bugs": {
    "url": "https://github.com/urffin/algiviz/issues"
  }
}
