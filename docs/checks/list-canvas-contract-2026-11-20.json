  "decisions": {
    "layout": "Iterative chain ranks x=i*nodeGap/y=0; output nodes storage order; explicit positions recorded atomically before yield; render never relayouts",
    "defaults": {
      "nodeGap": 4,
      "pointerGap": 1,
      "nullPointers": "visible",
      "nodeCaptions": "auto",
      "presentNode": "absent"
    },
    "geometry": "2x1 logical node, independent value/next compartments; permanent external head badge; null boxes belong to structural slots, never fake nodes",
    "fit": "Joint immutable endpoint glyph bounds plus potential null boxes for every slot, even non-null/hidden; routing gutter, 4px margin plus 8px stroke reserve; progress-independent contain",
    "retargeting": "Stable slot identity; own old/new references resolved at interpolated node/head centers; old 1-p/new p, no double owner fade",
    "presentation": "Current nodes then exits, once per union node even at zero presence; current/previous captured immutable snapshot respectively; no opaque coercion or ID fallback",
    "result": "Independent node-value and next/head compartment fills; selected slot route/null outline; result outranks roles/presenter; state-only and rewind safe",
    "text": "Measured labels/captions within compartments; deterministic safe omission against visible glyphs/text; routes clipped out of accepted text reservations",
    "ownership": "Frozen layout/render surface, no source/DPR/bitmap/context ownership or retained history; bounded to transient per-call state",
    "errors": "busy before arguments; both endpoints and safe geometry before callbacks/paint; original/falsy primary beats restore; no new error class",
    "canvasBoundary": "HTML Canvas 2D/DOM declarations; import/factory/layout no DOM globals; no existing entry or union changes",
    "staging": "Invalid working arenas/dangling assignments remain application-owned custom scenes"
  },
